<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stylized MotionLab "M" Wave with Keyframe Diamond -->
    <!-- Left Stem of M -->
    <path
        android:pathData="M28,74 L28,34 L38,34 L38,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="34"
                android:endX="38"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF00B4D8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Play/Motion V of M -->
    <path
        android:pathData="M38,34 L54,58 L70,34 L80,34 L80,74 L70,74 L70,48 L57.5,67 L50.5,67 L38,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="34"
                android:endX="80"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00DF81" />
                <item android:offset="1.0" android:color="#FF00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Keyframe Diamond (Gold) -->
    <path
        android:pathData="M54,64 L60,70 L54,76 L48,70 Z"
        android:fillColor="#FFFFD54F" />

</vector>
